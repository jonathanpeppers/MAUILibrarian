<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:asdfadfasddf"
             x:Class="asdfadfasddf.MainPage"
             x:DataType="local:MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EDF2EF">
    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Padding="24,28,24,22" Spacing="8" BackgroundColor="#18362F">
            <Label Text="THE ARCANE LIBRARY / FIELD GUIDE" FontSize="11" FontAttributes="Bold"
                   TextColor="#A9CFBA" CharacterSpacing="2" />
            <Label Text="Find its shelf." FontSize="31" FontAttributes="Bold"
                   TextColor="#F7F8F3" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="A book title is all you need." FontSize="14" TextColor="#CEDFD5" />
            <Border Margin="0,12,0,0" Padding="2,0" BackgroundColor="White"
                    StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <SearchBar x:Name="BookSearch" Placeholder="Search books or sections"
                           PlaceholderColor="#657A70" TextColor="#18362F"
                           BackgroundColor="Transparent" CancelButtonColor="#18362F"
                           TextChanged="OnSearchTextChanged" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="16,14,16,12">
            <Button x:Name="FirstFloorButton" Text="FIRST FLOOR" Clicked="OnFirstFloorClicked"
                    CornerRadius="5" FontSize="12" FontAttributes="Bold" HeightRequest="44" />
            <Button x:Name="SecondFloorButton" Grid.Column="1" Text="SECOND FLOOR"
                    Clicked="OnSecondFloorClicked" CornerRadius="5" FontSize="12"
                    FontAttributes="Bold" HeightRequest="44" />
        </Grid>

        <Grid Grid.Row="2" Padding="16,0,16,16">
            <Grid x:Name="MapPanel" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label x:Name="FloorHeading" FontSize="19" FontAttributes="Bold" TextColor="#18362F" />
                        <Label Text="Shelf map" FontSize="12" TextColor="#526B5D" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="−" Clicked="OnZoomOutClicked" WidthRequest="42"
                            HeightRequest="42" CornerRadius="5" BackgroundColor="#DAE6DF"
                            TextColor="#18362F" SemanticProperties.Description="Zoom map out" />
                    <Button Grid.Column="2" Text="+" Clicked="OnZoomInClicked" WidthRequest="42"
                            HeightRequest="42" CornerRadius="5" BackgroundColor="#DAE6DF"
                            TextColor="#18362F" SemanticProperties.Description="Zoom map in" />
                </Grid>

                <Border x:Name="SelectedShelfPanel" Grid.Row="1" IsVisible="False" Padding="14,12"
                        BackgroundColor="#DDECE1" Stroke="#93BA9E" StrokeShape="RoundRectangle 5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="SelectedShelfLabel" FontSize="18" FontAttributes="Bold"
                                   TextColor="#18362F" />
                            <Label x:Name="SelectedBookLabel" FontSize="12" TextColor="#405C4D"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Results" Clicked="OnBackToResultsClicked"
                                BackgroundColor="#18362F" TextColor="White" CornerRadius="5"
                                FontSize="12" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Stroke="#C9D9CE" StrokeThickness="1"
                        BackgroundColor="White" StrokeShape="RoundRectangle 5">
                    <ScrollView x:Name="MapScroller" Orientation="Both">
                        <Image x:Name="FloorMap" Aspect="AspectFit"
                               SemanticProperties.Description="Map of the selected library floor" />
                    </ScrollView>
                </Border>
                <HorizontalStackLayout Grid.Row="3" Spacing="16">
                    <Label Text="Floor guide" FontSize="11" TextColor="#365B4A"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFloorGuideTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Map credit" FontSize="11" TextColor="#365B4A"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapCreditTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="CC BY-SA" FontSize="11" TextColor="#365B4A"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLicenseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>

            <CollectionView x:Name="ResultsList" IsVisible="False"
                            SelectionMode="Single" SelectionChanged="OnResultSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:BookEntry">
                        <Border Margin="0,0,0,8" Padding="14,12" BackgroundColor="White"
                                Stroke="#D6E2DA" StrokeShape="RoundRectangle 5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                           TextColor="#18362F" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Section}" FontSize="12" TextColor="#526B5D" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Shelf}" FontSize="19" FontAttributes="Bold"
                                           HorizontalTextAlignment="End" TextColor="#B15136" />
                                    <Label Text="{Binding FloorLabel}" FontSize="10"
                                           HorizontalTextAlignment="End" TextColor="#526B5D" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No matching books. Try part of a title or a section name."
                           Margin="12,28" FontSize="14" TextColor="#526B5D"
                           HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
